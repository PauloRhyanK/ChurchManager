# Copiar para `.env` na raiz do projeto no servidor de dev.
# Arranque: docker compose -f docker-compose.dev.yml --env-file .env up -d --build

POSTGRES_USER=church
POSTGRES_PASSWORD=church
POSTGRES_DB=church_manager

PORT=3000
ENCRYPTION_KEY=
JWT_SECRET=substitua-por-string-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# CORS: origem do painel visto pelo browser (via nginx-gateway)
ADMIN_CORS_ORIGIN=http://admin.churchmanager.local
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Build do painel admin — URL da API no browser (incluir /api)
API_URL=http://api.churchmanager.local/api

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Opcional: seed na primeira subida
# RUN_SEED=true
