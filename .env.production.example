# Copia para `.env.production` na raiz (não commites com segredos reais).
# Na VPS: docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# (O Compose usa POSTGRES_* para o serviço `db` e monta DATABASE_URL da API.)

# Evita @ : / # ? nos valores — quebram o URL interno da API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SenhaSuperForte123
POSTGRES_DB=churchmanager_db

PORT=3000
ENCRYPTION_KEY=""
JWT_SECRET="substitua-por-string-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

ADMIN_CORS_ORIGIN="https://admin.exemplo.org"
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"

# Opcional: imagem da API (interpolação no compose)
# API_IMAGE=church-manager-api:latest
