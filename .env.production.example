# Copia para `.env.production` na raiz (não commites com segredos reais).
# Na VPS: docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# (Interpola POSTGRES_* e DATABASE_URL da API no compose. pgAdmin lê PGADMIN_* deste ficheiro via env_file.)
#
# pgAdmin: estas linhas só aplicam na PRIMEIRA subida do contentor. Depois o login fica no
# volume Docker `pgadmin_data` — apaga esse volume para voltar a ler daqui (ver comentários no docker-compose.prod.yml).

# Evita @ : / # ? nos valores — quebram o URL interno da API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SenhaSuperForte123
POSTGRES_DB=churchmanager_db

PORT=3000
ENCRYPTION_KEY=""
JWT_SECRET="substitua-por-string-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

ADMIN_CORS_ORIGIN="https://admin.exemplo.org"
# Produção: https://api.asaas.com/v3 — Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL="https://api.asaas.com/v3"

# Login na interface web do pgAdmin (obrigatório em produção)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=altera_esta_senha

# Obrigatório para produção com imagem pré-construída (GHCR ou outro registo).
# O Compose interpola esta linha ao ler o YAML — tens de passar o ficheiro explicitamente:
#   docker compose --env-file .env.production -f docker-compose.prod.yml pull api
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d api
# (Só `.env` na raiz é carregado por defeito; `.env.production` não é, a menos que uses --env-file.)
API_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/churchmanager/api:latest
