# Template para o `.env` do clone QA na VPS (não commites o .env).
# No clone ~/projetos/churchmanager-qa: cp .env.qa.example .env
#
# Gera segredos novos (não reutilizar os de produção):
#   openssl rand -hex 32   → ENCRYPTION_KEY
#   openssl rand -base64 48 → JWT_SECRET

# Postgres (serviço qa-db no compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_a_senha_qa
POSTGRES_DB=churchmanager_qa
DATABASE_URL="postgresql://postgres:altere_a_senha_qa@qa-db:5432/churchmanager_qa"

# API
PORT=3000
ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Base do painel admin — usada para montar URLs de convite e de cadastro público
ADMIN_WEB_BASE_URL=https://admin-qa.seudominio.com
# Validade padrão dos convites por e-mail (dias)
INVITATION_DEFAULT_EXPIRY_DAYS=7
# Validade padrão dos links de cadastro (dias); vazio = sem expiração
SIGNUP_LINK_DEFAULT_EXPIRY_DAYS=30

# Domínios — admin e API no mesmo host (nginx do admin faz proxy /api → qa-api; ver docker/admin-qa.nginx.conf)
ADMIN_CORS_ORIGIN=https://admin-qa.seudominio.com
API_URL=https://admin-qa.seudominio.com/api

# Seed — só na primeira subida; depois comentar ou remover RUN_SEED
ADMIN_SEED_EMAIL=admin@qa.local
ADMIN_SEED_PASSWORD=altere_a_senha
# RUN_SEED=true

# Resend — envio de e-mails (recuperação de senha, etc.)
RESEND_API_KEY=
MAIL_FROM="Church Manager <no-reply@seudominio.com>"

# Asaas — sempre sandbox em QA
ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# ngrok (perfil tunnel, opcional)
# NGROK_AUTHTOKEN=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=altere_a_senha

# Imagens pré-construídas (RECOMENDADO na VPS). Se vazio, faz build LOCAL na VPS,
# o que consome muita RAM/CPU (sobretudo o admin/Vite) e pode congelar o servidor.
# Preferir construir em CI/local, dar push para o GHCR e fazer só `pull` na VPS.
# API_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/churchmanager/api:latest
# ADMIN_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/churchmanager/admin:latest

# Se MESMO assim construíres o admin na VPS, limita o heap do Node no build (MB).
# Valor baixo evita OOM; se o build falhar por falta de memória, aumenta (ex.: 1536).
# ADMIN_BUILD_MEMORY=1024

# Cloudflare R2 — bucket QA separado de produção (ver docs/qa-cloudflare-npm-r2.md)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="churchmanager-uploads-qa"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
