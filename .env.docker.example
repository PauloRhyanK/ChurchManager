# Copia para `.env.docker` na raiz (não commites com segredos reais).
# Opcional: `docker compose --env-file .env.docker up` para usar POSTGRES_* abaixo na interpolação.
# Sem isso, o compose usa os valores por defeito (church / church / church_manager).

POSTGRES_USER=church
POSTGRES_PASSWORD=church
POSTGRES_DB=church_manager

PORT=3000
ENCRYPTION_KEY=""
JWT_SECRET="substitua-por-string-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

ADMIN_CORS_ORIGIN="http://localhost:8080"
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"

# Opcional
# RUN_SEED=true
# NGROK_AUTHTOKEN=
# PGADMIN_DEFAULT_EMAIL=admin@example.com
# PGADMIN_DEFAULT_PASSWORD=admin
# PGADMIN_PORT=5050
