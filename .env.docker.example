# Copie para .env.docker na raiz do repositório e preencha os segredos.
# docker compose lê .env.docker — não commite esse ficheiro com valores reais.
#
# DATABASE_URL e PORT são sobrescritos pelo docker-compose.yml para o serviço db.

DATABASE_URL="postgresql://church:church@db:5432/church_manager"
PORT=3000

# Obrigatório: 64 caracteres hexadecimais (32 bytes)
ENCRYPTION_KEY=""

# Obrigatório: mínimo 32 caracteres
JWT_SECRET="substitua-por-string-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# Origens do browser para admin/login (API no porto 3000). Sites públicos: BD (tenant_public_web_origins).
ADMIN_CORS_ORIGIN="http://localhost:8080"

# Asaas
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"

# Opcional: executar prisma seed no arranque do container (só dev)
# RUN_SEED=true

# Opcional: ngrok no Docker (perfil tunnel). Coloca o token de https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=

# Opcional: pgAdmin (perfil pgadmin). Sobrescreve o login por defeito da UI
# PGADMIN_DEFAULT_EMAIL=admin@localhost
# PGADMIN_DEFAULT_PASSWORD=muda_isto_em_dev
# PGADMIN_PORT=5050
