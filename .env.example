# Copia para `.env` na raiz (não commites). Usado por Docker Compose, API, Prisma e admin (Vite).
# Senha Postgres com @ # : ? etc. → codificar no DATABASE_URL (%40 para @).

# Prisma / Postgres - (arranque + migrações)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_a_senha
POSTGRES_DB=churchmanager_db
# Host `db` = serviço em docker-compose.yml e docker-compose.prod.yml
DATABASE_URL="postgresql://postgres:altere_a_senha@db:5432/churchmanager_db"
# Dev local sem Docker: postgresql://postgres:altere_a_senha@localhost:5432/churchmanager_db

# API
PORT=3000

# AppModule + CryptoService (64 caracteres hex)
ENCRYPTION_KEY=

# JWT - AuthModule
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Resend - MailModule (envio de e-mails: recuperação de senha, etc.)
RESEND_API_KEY=
# Remetente padrão. Deve usar um domínio verificado no Resend.
MAIL_FROM="Church Manager <no-reply@seudominio.com>"

# CORS - AdminModule
ADMIN_CORS_ORIGIN=http://localhost:5173

# Base pública do painel admin — URLs de convite e cadastro (/convite, /cadastro).
# Em QA/prod deve ser a URL oficial do admin. Se omitido, usa o primeiro valor de ADMIN_CORS_ORIGIN.
ADMIN_WEB_BASE_URL=http://localhost:5173
# Validade padrão dos convites por e-mail (dias)
INVITATION_DEFAULT_EXPIRY_DAYS=7

# Painel admin (Vite em dev e build Docker)
API_URL=http://localhost:3000/api

# Seed - prisma db seed (entrypoint Docker: RUN_SEED=true)
ADMIN_SEED_EMAIL=admin@demo.local
ADMIN_SEED_PASSWORD=demo123456
# RUN_SEED=true

# Asaas - FinancialModule
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_URL=https://api.asaas.com/v3

# ngrok (perfil tunnel: docker compose --profile tunnel up -d)
# NGROK_AUTHTOKEN=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=altere_a_senha
# PGADMIN_PORT=5050

# docker-compose.dev.yml (nginx-gateway): API_URL=http://api.churchmanager.local/api

# CI/CD — imagem da API (docker-compose.prod.yml)
API_IMAGE=ghcr.io/SEU_USUARIO_GITHUB/churchmanager/api:latest

# Cloudflare R2 Storage (AWS S3 Compatible)
R2_ACCESS_KEY_ID="tuas_access_key_aqui"
R2_SECRET_ACCESS_KEY="tuas_secret_key_aqui"
R2_ENDPOINT="https://<teu-account-id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="churchmanager-uploads"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev" # O link público que ativaste no passo 4

