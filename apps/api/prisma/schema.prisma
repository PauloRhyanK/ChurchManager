generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminUserRole {
  TENANT_ADMIN
  PLATFORM_ADMIN
  TENANT_MEMBER
}

enum AdminUserStatus {
  ACTIVE
  PENDING_APPROVAL
  INVITED
  SUSPENDED
}

enum PermissionModule {
  DASHBOARD
  EVENTS
  EVENT_REGISTRATIONS
  EVENT_TICKETS
  CHECKIN
  FINANCIAL
  SITE
  SETTINGS
  USERS
}

enum PermissionLevel {
  VIEW
  EDIT
}

enum EventFormat {
  IN_PERSON
  ONLINE
}

enum TicketVisibility {
  PUBLIC
  PRIVATE
}

enum EventFieldType {
  TEXT
  EMAIL
  PHONE
  CPF
  TEXTAREA
  SELECT
  CHECKBOX
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  /// Credencial Asaas cifrada em repouso (AES-256-GCM, formato iv:tag:ciphertext em hex) — não é hash.
  asaasApiKey String? @map("asaas_api_key") @db.Text
  /// Token de webhook Asaas cifrado (mesmo formato).
  asaasWebhookToken String? @map("asaas_webhook_token") @db.Text
  /// URL completo de retorno pós-pagamento Asaas (opcional; pode incluir `?query`). Validado contra origens públicas.
  paymentSuccessRedirectUrl String? @map("payment_success_redirect_url") @db.VarChar(2048)
  /// Se false, o URL acima não é usado como predefinição (o valor mantém-se para reativar depois).
  paymentSuccessRedirectEnabled Boolean @default(true) @map("payment_success_redirect_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payerProfiles      FinancialPayerProfile[]
  financialPlans     FinancialPlan[]
  subscriptions      FinancialSubscription[]
  transactions       FinancialTransaction[]
  webhookEvents      FinancialWebhookEvent[]
  paymentLinks       FinancialPaymentLink[]
  linkPresets        FinancialLinkPreset[]
  adminUsers         AdminUser[]
  permissionGroups   PermissionGroup[]
  signupLinks        TenantSignupLink[]
  invitations        AdminUserInvitation[]
  publicWebOrigins   TenantPublicWebOrigin[]
  events             Event[]
  eventTags          EventTag[]
  eventFieldDefs     EventFieldDefinition[]
  eventRegistrations EventRegistration[]
  eventTicketTypes   EventTicketType[]
  eventOrders        EventOrder[]
  eventTickets       EventTicket[]
  schedules          Schedule[]
  siteContent        SiteContent[]

  @@map("tenants")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  title       String      @db.VarChar(255)
  description String?     @db.Text
  format      EventFormat @default(IN_PERSON)
  /// URL de transmissão para eventos online.
  onlineUrl   String?     @map("online_url") @db.VarChar(2048)
  /// Resumo curto exibido em listagens/cards.
  shortDescription String? @map("short_description") @db.VarChar(500)
  /// Detalhes longos do evento (texto/HTML) para a página pública.
  detailsHtml String?     @map("details_html") @db.Text
  videoUrl    String?     @map("video_url") @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.Text
  /// Metadados de mídia (futuro upload Cloudflare): [{ kind, url, provider, assetId?, status? }].
  mediaMeta   Json?       @map("media_meta")
  date        DateTime    @db.Date
  timeStart   DateTime?   @map("time_start") @db.Time(0)
  timeEnd     DateTime?   @map("time_end") @db.Time(0)
  location    String?     @db.VarChar(255)
  /// Legado: imagem única (substituída por coverImageUrl). Mantido para retrocompatibilidade.
  imageUrl    String?     @map("image_url") @db.Text
  /// Legado: etiqueta única (substituída por tags). Mantido para retrocompatibilidade.
  tag         String?     @db.VarChar(64)
  published   Boolean     @default(true)
  slug        String?     @db.VarChar(120)
  timezone    String      @default("America/Sao_Paulo") @db.VarChar(64)
  registrationClosesAt DateTime? @map("registration_closes_at")
  termsUrl    String?     @map("terms_url") @db.VarChar(2048)
  currency    String      @default("BRL") @db.VarChar(3)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  ticketTypes   EventTicketType[]
  orders        EventOrder[]
  tags          EventTagOnEvent[]

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, published])
  @@unique([tenantId, slug])
  @@map("events")
}

/// Etiqueta reutilizável por tenant, associada a eventos via EventTagOnEvent.
model EventTag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(64)
  slug      String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events EventTagOnEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("event_tags")
}

model EventTagOnEvent {
  eventId String @map("event_id") @db.Uuid
  tagId   String @map("tag_id") @db.Uuid

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   EventTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
  @@map("event_tags_on_events")
}

model EventRegistration {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(32)
  message   String?  @db.Text
  /// ID de utilizador do site legado (ex. Supabase auth); sem FK.
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fieldValues EventRegistrationFieldValue[]

  @@unique([eventId, email], map: "event_registrations_event_email_unique")
  @@index([tenantId])
  @@index([eventId])
  @@index([email])
  @@index([userId])
  @@map("event_registrations")
}

enum EventOrderStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum EventTicketStatus {
  VALID
  CANCELLED
  REFUNDED
  USED
}

model EventTicketType {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  name            String           @db.VarChar(255)
  description     String?          @db.Text
  priceCents      Int              @map("price_cents")
  feeCents        Int              @default(0) @map("fee_cents")
  quantityTotal   Int?             @map("quantity_total")
  quantitySold    Int              @default(0) @map("quantity_sold")
  minPerOrder     Int              @default(1) @map("min_per_order")
  maxPerOrder     Int              @default(10) @map("max_per_order")
  salesOpensAt    DateTime?        @map("sales_opens_at")
  salesClosesAt   DateTime?        @map("sales_closes_at")
  /// PUBLIC = listado no site; PRIVATE = oculto, acessível por link directo.
  visibility      TicketVisibility @default(PUBLIC)
  /// Permite inscrição/compra sem login (utilizador anónimo).
  allowGuestRegistration Boolean   @default(true) @map("allow_guest_registration")
  /// Link de grupo/comunidade (ex. WhatsApp) exibido após a inscrição.
  communityLink   String?          @map("community_link") @db.VarChar(2048)
  /// Tipos de pagamento permitidos: PIX, BOLETO, CREDIT_CARD, UNDEFINED.
  allowedBillingTypes String[]     @map("allowed_billing_types")
  /// Máximo de parcelas no cartão (null = à vista).
  maxInstallments Int?             @map("max_installments")
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event        Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderLines   EventOrderLine[]
  tickets      EventTicket[]
  fieldConfigs EventTicketTypeField[]

  @@index([tenantId])
  @@index([eventId])
  @@map("event_ticket_types")
}

/// Definição de campo de inscrição por tenant (padrão do sistema ou personalizado).
model EventFieldDefinition {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  key       String         @db.VarChar(80)
  label     String         @db.VarChar(255)
  type      EventFieldType
  /// Opções para campos SELECT: string[].
  options   Json?
  /// Campo padrão do sistema (não removível pelo utilizador).
  isSystem  Boolean        @default(false) @map("is_system")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketConfigs     EventTicketTypeField[]
  registrationValues EventRegistrationFieldValue[]
  orderValues       EventOrderFieldValue[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("event_field_definitions")
}

/// Configuração de um campo num tipo de ingresso (activo/obrigatório/ordem).
model EventTicketTypeField {
  ticketTypeId String  @map("ticket_type_id") @db.Uuid
  fieldId      String  @map("field_id") @db.Uuid
  enabled      Boolean @default(true)
  required     Boolean @default(false)
  sortOrder    Int     @default(0) @map("sort_order")

  ticketType EventTicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  field      EventFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([ticketTypeId, fieldId])
  @@index([fieldId])
  @@map("event_ticket_type_fields")
}

model EventRegistrationFieldValue {
  registrationId String @map("registration_id") @db.Uuid
  fieldId        String @map("field_id") @db.Uuid
  value          String @db.Text

  registration EventRegistration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  field        EventFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([registrationId, fieldId])
  @@index([fieldId])
  @@map("event_registration_field_values")
}

model EventOrderFieldValue {
  orderId String @map("order_id") @db.Uuid
  fieldId String @map("field_id") @db.Uuid
  value   String @db.Text

  order EventOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field EventFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([orderId, fieldId])
  @@index([fieldId])
  @@map("event_order_field_values")
}

model EventOrder {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  eventId         String           @map("event_id") @db.Uuid
  payerProfileId  String?          @map("payer_profile_id") @db.Uuid
  status          EventOrderStatus @default(PENDING)
  totalCents      Int              @map("total_cents")
  currency        String           @default("BRL") @db.VarChar(3)
  idempotencyKey  String?          @unique @map("idempotency_key") @db.VarChar(128)
  confirmedAt     DateTime?        @map("confirmed_at")
  /// Momento em que os bilhetes foram entregues por e-mail. Nulo => ainda não enviados (o webhook Asaas pode repetir).
  ticketsEmailSentAt DateTime?     @map("tickets_email_sent_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer        FinancialPayerProfile?   @relation(fields: [payerProfileId], references: [id], onDelete: SetNull)
  lines        EventOrderLine[]
  tickets      EventTicket[]
  transactions FinancialTransaction[]
  fieldValues  EventOrderFieldValue[]

  @@index([tenantId])
  @@index([eventId])
  @@index([tenantId, status])
  @@map("event_orders")
}

model EventOrderLine {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  ticketTypeId   String   @map("ticket_type_id") @db.Uuid
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents")
  /// Nome por ingresso da linha (índice = unidade). Vazio => herda o nome do pagador.
  holderNames    String[] @map("holder_names")

  order      EventOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([orderId, ticketTypeId])
  @@map("event_order_lines")
}

model EventTicket {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  orderId      String            @map("order_id") @db.Uuid
  ticketTypeId String            @map("ticket_type_id") @db.Uuid
  publicCode   String            @unique @map("public_code") @db.VarChar(32)
  holderName   String            @map("holder_name") @db.VarChar(255)
  status       EventTicketStatus @default(VALID)
  /// Presença (check-in). Nulo => ainda não deu entrada.
  checkedInAt       DateTime? @map("checked_in_at")
  /// Voluntário que registou a entrada (sem FK; snapshot preservado).
  checkedInByUserId String?   @map("checked_in_by_user_id") @db.Uuid
  checkedInByName   String?   @map("checked_in_by_name") @db.VarChar(255)
  createdAt    DateTime          @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order      EventOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([orderId])
  @@index([tenantId, checkedInAt])
  @@map("event_tickets")
}

model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  dayOfWeek   String   @map("day_of_week") @db.VarChar(16)
  timeStart   DateTime @map("time_start") @db.Time(0)
  location    String?  @db.VarChar(255)
  description String?  @db.Text
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, active])
  @@map("schedules")
}

/// Conteúdo editável do site público, uma linha por secção (`key`).
/// O formato de `value` é validado na aplicação pelo registry em
/// `modules/site/site-content.registry.ts` — chaves fora do registry são rejeitadas.
model SiteContent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(64)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("site_content")
}

enum FinancialLinkModule {
  COTAS
  EVENTS
}

enum FinancialPaymentLinkMode {
  PRESET_GLOBAL
  CPF_CUSTOM
  EVENT_AUTO
}

/// Origens de browser (scheme + host + port) autorizadas a chamar `/api/public/tenants/:slug/...` (CORS).
model TenantPublicWebOrigin {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  origin    String   @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, origin])
  @@index([tenantId])
  @@map("tenant_public_web_origins")
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  email        String          @unique @db.VarChar(255)
  name         String?         @db.VarChar(255)
  /// Nulo enquanto o utilizador está em INVITED (ainda não definiu senha).
  passwordHash String?         @map("password_hash") @db.VarChar(255)
  role         AdminUserRole   @default(TENANT_ADMIN)
  status       AdminUserStatus @default(ACTIVE)
  approvedAt   DateTime?       @map("approved_at")
  approvedById String?         @map("approved_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissionGroups AdminUserPermissionGroup[]
  invitations      AdminUserInvitation[]
  passwordResets   AdminPasswordReset[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("admin_users")
}

/// Grupo de permissões por tenant. Reúne acessos por módulo (VIEW/EDIT).
model PermissionGroup {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries PermissionGroupEntry[]
  members AdminUserPermissionGroup[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("permission_groups")
}

/// Permissão atómica de um grupo: um módulo com um nível de acesso.
model PermissionGroupEntry {
  id      String           @id @default(uuid()) @db.Uuid
  groupId String           @map("group_id") @db.Uuid
  module  PermissionModule
  level   PermissionLevel

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, module])
  @@index([groupId])
  @@map("permission_group_entries")
}

/// Associação N:N entre utilizadores e grupos de permissões.
model AdminUserPermissionGroup {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid

  user  AdminUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@map("admin_user_permission_groups")
}

/// Link de cadastro aberto (auto-registo com aprovação posterior).
model TenantSignupLink {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  token           String    @unique @db.VarChar(255)
  label           String?   @db.VarChar(255)
  /// Ids de PermissionGroup atribuídos ao aprovar quem se regista por este link.
  defaultGroupIds Json?     @map("default_group_ids")
  expiresAt       DateTime? @map("expires_at")
  maxUses         Int?      @map("max_uses")
  useCount        Int       @default(0) @map("use_count")
  isActive        Boolean   @default(true) @map("is_active")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_signup_links")
}

/// Convite individual por e-mail. Cria um AdminUser em INVITED até definir senha.
model AdminUserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String    @db.VarChar(255)
  token       String    @unique @db.VarChar(255)
  userId      String?   @map("user_id") @db.Uuid
  /// Ids de PermissionGroup a atribuir quando o convite é aceite.
  groupIds    Json?     @map("group_ids")
  expiresAt   DateTime  @map("expires_at")
  completedAt DateTime? @map("completed_at")
  invitedById String?   @map("invited_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([email])
  @@map("admin_user_invitations")
}

/// Pedido de recuperação de senha. Token opaco de uso único com expiração.
model AdminPasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String    @db.VarChar(255)
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@map("admin_password_resets")
}

model FinancialPayerProfile {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  cpf              String   @db.Char(11)
  name             String   @db.VarChar(255)
  email            String   @db.VarChar(255)
  phone            String?  @db.VarChar(20)
  asaasCustomerId  String?  @map("asaas_customer_id") @db.VarChar(64)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions  FinancialSubscription[]
  transactions   FinancialTransaction[]
  eventOrders    EventOrder[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@map("financial_payer_profiles")
}

model FinancialPlan {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  amountCents   Int      @map("amount_cents")
  currency      String   @default("BRL") @db.VarChar(3)
  interval      String?  @db.VarChar(32)
  asaasPlanId   String?  @map("asaas_plan_id") @db.VarChar(64)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions  FinancialSubscription[]

  @@index([tenantId])
  @@map("financial_plans")
}

model FinancialSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  payerProfileId       String?   @map("payer_profile_id") @db.Uuid
  asaasCustomerId      String    @map("asaas_customer_id") @db.VarChar(64)
  asaasSubscriptionId  String?   @map("asaas_subscription_id") @db.VarChar(64)
  status               String    @db.VarChar(32)
  currentPeriodEnd     DateTime? @map("current_period_end")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     FinancialPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  payer    FinancialPayerProfile? @relation(fields: [payerProfileId], references: [id], onDelete: SetNull)
  transactions FinancialTransaction[]

  @@index([tenantId])
  @@unique([asaasSubscriptionId])
  @@map("financial_subscriptions")
}

model FinancialTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  subscriptionId    String?  @map("subscription_id") @db.Uuid
  payerProfileId    String?  @map("payer_profile_id") @db.Uuid
  eventOrderId      String?  @map("event_order_id") @db.Uuid
  asaasPaymentId    String?  @map("asaas_payment_id") @db.VarChar(64)
  asaasEventId      String?  @unique @map("asaas_event_id") @db.VarChar(128)
  type              String   @db.VarChar(64)
  amountCents       Int      @map("amount_cents")
  status            String   @db.VarChar(32)
  billingType       String?  @map("billing_type") @db.VarChar(32)
  rawPayloadRef     Json?    @map("raw_payload_ref")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription FinancialSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payer        FinancialPayerProfile?   @relation(fields: [payerProfileId], references: [id], onDelete: SetNull)
  eventOrder   EventOrder?            @relation(fields: [eventOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([asaasPaymentId])
  @@index([eventOrderId])
  @@map("financial_transactions")
}

/// Dedup de webhooks Asaas (idempotência)
model FinancialWebhookEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  idempotencyKey String  @unique @map("idempotency_key") @db.VarChar(256)
  eventType     String   @map("event_type") @db.VarChar(128)
  paymentId     String?  @map("payment_id") @db.VarChar(64)
  processedAt   DateTime @default(now()) @map("processed_at")
  payload       Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("financial_webhook_events")
}

model FinancialLinkPreset {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @map("tenant_id") @db.Uuid
  module                     FinancialLinkModule
  presetKey                  String              @map("preset_key") @db.VarChar(80)
  name                       String              @db.VarChar(255)
  sourceKey                  String              @map("source_key") @db.VarChar(120)
  isMonthly                  Boolean             @map("is_monthly")
  subscriptionDurationMonths Int?                @map("subscription_duration_months")
  valueCents                 Int?                @map("value_cents")
  successUrl                 String?             @map("success_url") @db.VarChar(2048)
  autoRedirect               Boolean?            @map("auto_redirect")
  active                     Boolean             @default(true)
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentLinks FinancialPaymentLink[]

  @@unique([tenantId, module, presetKey])
  @@index([tenantId, module, active])
  @@map("financial_link_presets")
}

model FinancialPaymentLink {
  id                         String                   @id @default(uuid()) @db.Uuid
  tenantId                   String                   @map("tenant_id") @db.Uuid
  presetId                   String?                  @map("preset_id") @db.Uuid
  provider                   String                   @default("asaas") @db.VarChar(32)
  providerLinkId             String                   @map("provider_link_id") @db.VarChar(80)
  url                        String                   @db.VarChar(2048)
  module                     FinancialLinkModule
  sourceKey                  String                   @map("source_key") @db.VarChar(120)
  mode                       FinancialPaymentLinkMode
  reuseKey                   String                   @map("reuse_key") @db.VarChar(255)
  cpf                        String?                  @db.Char(11)
  payerName                  String?                  @map("payer_name") @db.VarChar(255)
  isMonthly                  Boolean                  @map("is_monthly")
  subscriptionDurationMonths Int?                     @map("subscription_duration_months")
  valueCents                 Int?                     @map("value_cents")
  successUrl                 String?                  @map("success_url") @db.VarChar(2048)
  autoRedirect               Boolean?                 @map("auto_redirect")
  active                     Boolean                  @default(true)
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preset  FinancialLinkPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  @@unique([tenantId, reuseKey])
  @@unique([tenantId, providerLinkId])
  @@index([tenantId, module, mode, active])
  @@index([tenantId, cpf])
  @@map("financial_payment_links")
}
