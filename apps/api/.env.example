# Prisma / Postgres - (arranque + migrações)
DATABASE_URL="postgresql://user:password@localhost:5432/church_manager"

# API
PORT=3000

# AppModule + CryptoService
ENCRYPTION_KEY=""

# JWT - AuthModule
JWT_SECRET="substitua-por-string-secreta-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"

# CORS — origens do browser para login e painel admin (lista separada por vírgula).
# Sites públicos por igreja: tabela tenant_public_web_origins (API / painel), não esta variável.
ADMIN_CORS_ORIGIN="http://localhost:5173"

# Seed - AdminModule (prisma db seed)
# ADMIN_SEED_EMAIL="admin@demo.local"
# ADMIN_SEED_PASSWORD="altere-esta-senha"

# Asaas - FinancialModule (URL do ambiente)
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
